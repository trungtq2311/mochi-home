{
  "name": "cozy-haven",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "build:artifact": "node scripts/build-artifact.mjs",
    "art": "node scripts/art.ts",
    "art:status": "node scripts/art.ts status",
    "art:prompts": "node scripts/art.ts prompts",
    "deploy": "node scripts/deploy.mjs",
    "icons": "node scripts/icons.ts",
    "sync": "npm run build && cap sync"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "^26.6.5",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/baloo-2": "^5.3.0"
  }
}
